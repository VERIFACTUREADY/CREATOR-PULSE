####################################################################
# CreatorPulse AI — configuración de ejemplo
# Copia este fichero a `.env` y ajusta los valores.
#   cp .env.example .env
####################################################################

# ---------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------
APP_ENV=development
APP_NAME=CreatorPulse AI
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------
POSTGRES_DB=creator_signal
POSTGRES_USER=creator_signal
POSTGRES_PASSWORD=change-me
# Dentro de docker compose el host es `postgres`; en local suele ser `localhost`.
DATABASE_URL=postgresql+psycopg://creator_signal:change-me@postgres:5432/creator_signal
# `auto` usa pgvector si la extensión está disponible; `true` la exige; `false` la desactiva.
PGVECTOR_MODE=auto

# ---------------------------------------------------------------
# Redis / cola de trabajos
# ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=analysis
RQ_JOB_TIMEOUT_SECONDS=1800

# ---------------------------------------------------------------
# YouTube Data API v3
# ---------------------------------------------------------------
# Sin clave, la aplicación sigue funcionando en modo demostración.
YOUTUBE_API_KEY=
YOUTUBE_MAX_VIDEOS_PER_ANALYSIS=20
YOUTUBE_MAX_COMMENTS_PER_VIDEO=250
YOUTUBE_MAX_COMMENTS_PER_CHANNEL=3000
YOUTUBE_INCLUDE_REPLIES=false
YOUTUBE_CACHE_TTL_HOURS=24
YOUTUBE_REQUEST_TIMEOUT_SECONDS=30
YOUTUBE_MAX_RETRIES=4
# Límites máximos absolutos que el formulario no puede superar.
YOUTUBE_HARD_MAX_VIDEOS=50
YOUTUBE_HARD_MAX_COMMENTS_PER_VIDEO=500
YOUTUBE_HARD_MAX_COMMENTS_PER_CHANNEL=10000

# ---------------------------------------------------------------
# Control de acceso
# ---------------------------------------------------------------
# Esta aplicación NO tiene usuarios propios. Para exponerla a internet hay que
# ponerla detrás de algo que autentique (Cloudflare Access, Azure Easy Auth, un
# reverse proxy con OIDC) y que inyecte una cabecera compartida.
#   none          -> sin protección. Sólo desarrollo. En APP_ENV=production la
#                    aplicación se NIEGA A ARRANCAR con este valor.
#   trusted_proxy -> exige la cabecera, y sólo la acepta si la petición viene
#                    de una de las redes indicadas abajo.
AUTH_MODE=none
TRUSTED_AUTH_HEADER=X-Auth-Token
TRUSTED_AUTH_VALUE=
# Redes desde las que se acepta la cabecera (CIDR separados por comas). Sin
# esto, cualquiera con acceso directo a la API podría falsificarla.
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# ---------------------------------------------------------------
# Modo propietario (OAuth) — desactivado por defecto
# ---------------------------------------------------------------
# Con ENABLE_OWNER_MODE=true puedes conectar tu propio canal por OAuth de
# Google y consultar métricas privadas de YouTube Analytics. Se piden
# permisos de SÓLO LECTURA y nunca se te pide tu contraseña.
# Requiere las cuatro variables siguientes; si falta alguna, la API responde
# «configuración incompleta» en lugar de arrancar un flujo roto.
ENABLE_OWNER_MODE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la URI autorizada en Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
# Clave Fernet (base64 urlsafe de 32 bytes) para cifrar tokens en reposo.
# Generar con:  cd backend && .venv/bin/python -m app.cli generar-clave
OAUTH_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------
# Proveedor LLM opcional (el cálculo numérico NUNCA depende de él)
# ---------------------------------------------------------------
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# ---------------------------------------------------------------
# Modelos de análisis local
# ---------------------------------------------------------------
# hashing = determinista y sin descargas (por defecto)
# sentence-transformers = requiere el extra `ml` instalado
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# lexicon = determinista multilingüe (por defecto) | transformers = requiere el extra `ml`
SENTIMENT_BACKEND=lexicon
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
ENABLE_TOXICITY_ANALYSIS=true
CLUSTERING_MIN_CLUSTER_SIZE=5
CLUSTERING_MIN_COMMENTS=30

# ---------------------------------------------------------------
# Privacidad y retención
# ---------------------------------------------------------------
DATA_RETENTION_DAYS=90
ANONYMIZE_COMMENT_AUTHORS=true
# Sal usada para el hash de los identificadores de autor. Cámbiala en producción.
AUTHOR_HASH_SALT=change-me-author-salt

# ---------------------------------------------------------------
# Observabilidad y límites
# ---------------------------------------------------------------
# Directorio de los datos de demostración. Vacío = detección automática.
# La imagen de Docker lo fija a /fixtures.
FIXTURES_DIR=

LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_DEMO_MODE=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
