    "header": {
      "type": "ds-page-header",
      "settings": {
        "color_scheme": "scheme-2",
        "lead": "<p>Respuestas cortas a las dudas más comunes. Si no encuentras la tuya, <a href=\"/pages/contacto\">escríbenos</a>.</p>",
        "review": "sanitaria",
        "show_review_date": true
      }
    },
    "faq": {
