{%- comment -%}
  Aviso destacado: información, precaución, estado de prototipo, cita o
  llamada final. Las precauciones no se esconden ni se resumen en exceso.
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
<section
  class="ds-callout-section ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
>
  <div class="page-width">
    <div class="ds-callout ds-callout--{{ section.settings.style }}"{% if section.settings.style == 'caution' %} role="note"{% endif %}>
      <span class="ds-callout__icon">{%- render 'ds-icon', name: section.settings.icon -%}</span>
      <div class="ds-callout__body">
        {%- render 'ds-review-badge', kind: section.settings.review -%}
        {%- if section.settings.heading != blank -%}
          {%- if section.settings.heading_level == 'h1' -%}
            <h1 class="ds-callout__title">{{ section.settings.heading | escape }}</h1>
          {%- else -%}
            <h2 class="ds-callout__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.text != blank -%}<div class="ds-rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.source_label != blank -%}
          <span class="ds-source">
            {{- 'ds.sources.label' | t }}:
            {% if section.settings.source_url != blank -%}
              <a href="{{ section.settings.source_url }}" rel="noopener" target="_blank">{{ section.settings.source_label | escape }}<span class="visually-hidden"> ({{ 'accessibility.link_messages.new_window' | t }})</span></a>
            {%- else -%}
              {{- section.settings.source_label | escape -}}
            {%- endif -%}
          </span>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="button{% if section.settings.button_secondary %} button--secondary{% else %} button--primary{% endif %}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "DS · Aviso destacado",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "visible_in",
      "label": "Mostrar en",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todos los estados"
        },
        {
          "value": "prototipo",
          "label": "Solo PROTOTIPO"
        },
        {
          "value": "comercial",
          "label": "Solo PREVIEW_COMERCIAL y LIVE"
        },
        {
          "value": "no_live",
          "label": "Todos salvo LIVE"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla (id para enlaces internos)"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "default": "info",
      "options": [
        {
          "value": "info",
          "label": "Información"
        },
        {
          "value": "caution",
          "label": "Precaución"
        },
        {
          "value": "prototype",
          "label": "Estado de prototipo / pendiente"
        },
        {
          "value": "quote",
          "label": "Frase destacada"
        },
        {
          "value": "center",
          "label": "Llamada final centrada"
        }
      ]
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icono",
      "default": "info",
      "options": [
        {
          "value": "info",
          "label": "Información"
        },
        {
          "value": "alert",
          "label": "Atención"
        },
        {
          "value": "doc",
          "label": "Documento"
        },
        {
          "value": "moon",
          "label": "Luna"
        },
        {
          "value": "pillows",
          "label": "Almohadas"
        },
        {
          "value": "question",
          "label": "Pregunta"
        },
        {
          "value": "chat",
          "label": "Conversación"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Nivel del título",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h1",
          "label": "H1 (solo si la página no tiene otro)"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "source_label",
      "label": "Fuente (nombre)"
    },
    {
      "type": "url",
      "id": "source_url",
      "label": "Fuente (enlace)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "button_secondary",
      "label": "Botón secundario",
      "default": false
    },
    {
      "type": "select",
      "id": "review",
      "label": "Marcador de revisión",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Ninguno"
        },
        {
          "value": "sanitaria",
          "label": "Pendiente de revisión sanitaria"
        },
        {
          "value": "juridica",
          "label": "Pendiente de revisión jurídica"
        },
        {
          "value": "fabricante",
          "label": "Pendiente de documentación del fabricante"
        },
        {
          "value": "titular",
          "label": "Pendiente de aprobación del titular"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "DS · Aviso destacado"
    }
  ]
}
{% endschema %}
