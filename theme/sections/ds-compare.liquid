{%- comment -%}
  Comparativa de mecanismos (Estudio §15). Compara cómo actúan, no cuál
  «funciona mejor». En móvil la tabla se convierte en tarjetas.
{%- endcomment -%}
<section
  class="ds-compare ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  aria-labelledby="DsCompareTitle-{{ section.id }}"
>
  <div class="page-width">
    <div class="ds-section-head">
      {%- render 'ds-review-badge', kind: section.settings.review -%}
      <h2 id="DsCompareTitle-{{ section.id }}" class="ds-heading h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<div class="ds-rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    <table class="ds-compare__table">
      {%- if section.settings.caption != blank -%}<caption>{{ section.settings.caption | escape }}</caption>{%- endif -%}
      <thead>
        <tr>
          <th scope="col">{{ section.settings.col_1 | escape }}</th>
          <th scope="col">{{ section.settings.col_2 | escape }}</th>
          <th scope="col">{{ section.settings.col_3 | escape }}</th>
          <th scope="col">{{ section.settings.col_4 | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.name | escape }}</th>
            <td data-label="{{ section.settings.col_2 | escape }}">{{ block.settings.what | escape }}</td>
            <td data-label="{{ section.settings.col_3 | escape }}">{{ block.settings.where | escape }}</td>
            <td data-label="{{ section.settings.col_4 | escape }}">{{ block.settings.consider | escape }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

{% schema %}
{
  "name": "DS · Comparativa",
  "tag": "div",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "text", "id": "anchor", "label": "Ancla" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Qué opciones existen" },
    { "type": "richtext", "id": "intro", "label": "Introducción" },
    { "type": "text", "id": "caption", "label": "Nota de la tabla" },
    { "type": "text", "id": "col_1", "label": "Columna 1", "default": "Opción" },
    { "type": "text", "id": "col_2", "label": "Columna 2", "default": "Qué es" },
    { "type": "text", "id": "col_3", "label": "Columna 3", "default": "Dónde actúa" },
    { "type": "text", "id": "col_4", "label": "Columna 4", "default": "A tener en cuenta" },
    {
      "type": "select", "id": "review", "label": "Marcador de revisión", "default": "",
      "options": [{ "value": "", "label": "Ninguno" }, { "value": "sanitaria", "label": "Pendiente de revisión sanitaria" }]
    },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Opción",
      "settings": [
        { "type": "text", "id": "name", "label": "Opción", "default": "Opción" },
        { "type": "text", "id": "what", "label": "Qué es" },
        { "type": "text", "id": "where", "label": "Dónde actúa" },
        { "type": "text", "id": "consider", "label": "A tener en cuenta" }
      ]
    }
  ],
  "presets": [{ "name": "DS · Comparativa", "blocks": [{ "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
