{%- comment -%}
  Contenido editorial en capas: títulos con ancla, texto, avisos y fuentes.
  Índice «En esta página» opcional generado a partir de los títulos H2.
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
{%- liquid
  assign toc_count = 0
  for block in section.blocks
    if block.type == 'heading' and block.settings.level == 'h2' and block.settings.anchor != blank
      assign toc_count = toc_count | plus: 1
    endif
  endfor
  assign show_toc = false
  if section.settings.show_toc and toc_count > 1
    assign show_toc = true
  endif
-%}
<section
  class="ds-content ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
>
  <div class="page-width">
    <div class="ds-content__layout{% if show_toc %} ds-content__layout--toc{% endif %}">
      {%- if show_toc -%}
        <nav class="ds-toc" aria-labelledby="DsToc-{{ section.id }}">
          <p class="ds-toc__title" id="DsToc-{{ section.id }}">{{ 'ds.toc.title' | t }}</p>
          <ol>
            {%- for block in section.blocks -%}{%- capture ds_bshow -%}{%- render 'ds-visible', when: block.settings.visible_in -%}{%- endcapture -%}{%- if ds_bshow == 'true' -%}
              {%- if block.type == 'heading' and block.settings.level == 'h2' and block.settings.anchor != blank -%}
                <li><a href="#{{ block.settings.anchor | handleize }}">{{ block.settings.text | escape }}</a></li>
              {%- endif -%}
            {%- endif -%}{%- endfor -%}
          </ol>
        </nav>
      {%- endif -%}
      <div class="ds-content__body">
        {%- render 'ds-review-badge', kind: section.settings.review -%}
        {%- for block in section.blocks -%}{%- capture ds_bshow -%}{%- render 'ds-visible', when: block.settings.visible_in -%}{%- endcapture -%}{%- if ds_bshow == 'true' -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <{{ block.settings.level }} {{ block.shopify_attributes }}{% if block.settings.anchor != blank %} id="{{ block.settings.anchor | handleize }}"{% endif %}>{{ block.settings.text | escape }}</{{ block.settings.level }}>
            {%- when 'text' -%}
              <div class="ds-content__block ds-rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'callout' -%}
              <div class="ds-callout ds-callout--{{ block.settings.style }}" {{ block.shopify_attributes }}{% if block.settings.style == 'caution' %} role="note"{% endif %}>
                <span class="ds-callout__icon">{%- render 'ds-icon', name: block.settings.icon -%}</span>
                <div class="ds-callout__body">
                  {%- render 'ds-review-badge', kind: block.settings.review -%}
                  {%- if block.settings.title != blank -%}<p class="ds-callout__title h3">{{ block.settings.title | escape }}</p>{%- endif -%}
                  <div class="ds-rte">{{ block.settings.text }}</div>
                  {%- if block.settings.pending_label != blank -%}<p>{%- render 'ds-pending', label: block.settings.pending_label -%}</p>{%- endif -%}
                </div>
              </div>
            {%- when 'sources' -%}
              <div class="ds-sources ds-rte" {{ block.shopify_attributes }}>
                <h2>{{ block.settings.title | escape }}</h2>
                {{ block.settings.text }}
              </div>
            {%- when 'divider' -%}
              <hr class="ds-divider" {{ block.shopify_attributes }}>
          {%- endcase -%}
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

