{%- comment -%}
  Hero de marca. Estudio §12.2: una sola idea, una CTA informativa, sin
  promesas médicas. La ilustración es decorativa y no representa el producto.
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
<section
  class="ds-hero ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  aria-labelledby="DsHeroTitle-{{ section.id }}"
>
  <div class="page-width ds-hero__grid">
    <div class="ds-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 550, 750, 1100, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'ds-ilustracion-noche.svg' | inline_asset_content }}
      {%- endif -%}
    </div>
    <div class="ds-hero__content">
      {%- render 'ds-review-badge', kind: section.settings.review -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="DsHeroTitle-{{ section.id }}" class="ds-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="ds-hero__text ds-rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="ds-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_link | default: '#' }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <nav aria-label="{{ section.settings.quick_label | escape }}">
            <ul class="ds-hero__quick" role="list">
              {%- for block in section.blocks -%}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "DS · Hero de marca",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "visible_in",
      "label": "Mostrar en",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todos los estados"
        },
        {
          "value": "prototipo",
          "label": "Solo PROTOTIPO"
        },
        {
          "value": "comercial",
          "label": "Solo PREVIEW_COMERCIAL y LIVE"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (solo con licencia o autorización)",
      "info": "Si se deja vacío, se muestra la ilustración original del prototipo. No usar fotos de terceros sin licencia ni fotos que simulen resultados."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Sleeping as a couple"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular (H1)",
      "default": "Because you share the night."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Snoring can affect the nights you share. Learn about its causes and the options available.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón principal",
      "default": "Understand your options",
      "info": "Durante el prototipo, la acción debe ser informativa, nunca de compra."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "text",
      "id": "quick_label",
      "label": "Nombre accesible de los enlaces rápidos",
      "default": "Quick links"
    },
    {
      "type": "select",
      "id": "review",
      "label": "Marcador de revisión",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Ninguno"
        },
        {
          "value": "sanitaria",
          "label": "Pendiente de revisión sanitaria"
        },
        {
          "value": "juridica",
          "label": "Pendiente de revisión jurídica"
        },
        {
          "value": "titular",
          "label": "Pendiente de aprobación del titular"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Enlace rápido",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "What it is"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS · Hero de marca"
    }
  ]
}
{% endschema %}
