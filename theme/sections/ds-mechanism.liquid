{%- comment -%}
  V3 · «Cómo funciona»: diagrama original + tres pasos + precauciones visibles.
  - El diagrama es de CATEGORÍA (avance mandibular). Mientras «Mecanismo confirmado
    con el fabricante» esté desmarcado, se muestra un aviso ⟦PENDING⟧ junto a él.
  - Los pasos salen de bloques (explicación general) o del metacampo
    commercial.how_to_steps del producto (instrucciones aprobadas del fabricante).
  - Las precauciones no se esconden: siempre debajo de los pasos.
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
-%}
<section
  class="ds-mech ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  aria-labelledby="DsMech-{{ section.id }}"
>
  <div class="page-width">
    {%- capture head_id -%}DsMech-{{ section.id }}{%- endcapture -%}
    {%- render 'ds-section-head',
      id: head_id,
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      intro: section.settings.intro,
      review: section.settings.review
    -%}
    <div class="ds-mech__grid{% unless section.settings.show_diagram %} ds-mech__grid--single{% endunless %}">
      {%- if section.settings.show_diagram -%}
        <figure class="ds-mech__figure">
          {%- render 'ds-diagram-mad', id: section.id, title: section.settings.diagram_title -%}
          <figcaption>
            <ol class="ds-mech__legend" role="list">
              <li><span aria-hidden="true">1</span> {{ section.settings.legend_1 | escape }}</li>
              <li><span aria-hidden="true">2</span> {{ section.settings.legend_2 | escape }}</li>
              <li><span aria-hidden="true">3</span> {{ section.settings.legend_3 | escape }}</li>
              <li><span aria-hidden="true">4</span> {{ section.settings.legend_4 | escape }}</li>
            </ol>
            {%- unless section.settings.mechanism_verified -%}
              <p class="ds-mech__note">{%- render 'ds-pending', label: 'confirm with the manufacturer that this exact model works this way' -%}</p>
            {%- endunless -%}
          </figcaption>
        </figure>
      {%- endif -%}
      <div class="ds-mech__steps">
        <ol class="ds-mech__list" role="list">
          {%- if section.settings.steps_source == 'metafield' -%}
            {%- assign m = p.metafields.commercial.how_to_steps -%}
            {%- if m != blank -%}
              {%- if m.type contains 'list.' -%}
                {%- assign steps = m.value -%}
              {%- else -%}
                {%- assign steps = m.value | newline_to_br | split: '<br />' -%}
              {%- endif -%}
              {%- for step in steps limit: 5 -%}
                {%- assign st = step | strip -%}
                {%- if st != blank -%}
                  <li class="ds-mech__step"><span class="ds-mech__num" aria-hidden="true">{{ forloop.index }}</span><p class="ds-mech__title">{{ st | escape }}</p></li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..3) -%}
                <li class="ds-mech__step"><span class="ds-mech__num" aria-hidden="true">{{ i }}</span><p class="ds-mech__title">{%- render 'ds-pending', label: 'how-to step from the manufacturer’s instructions' -%}</p></li>
              {%- endfor -%}
            {%- endif -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <li class="ds-mech__step" {{ block.shopify_attributes }}>
                <span class="ds-mech__num" aria-hidden="true">{{ forloop.index }}</span>
                <div>
                  <p class="ds-mech__title">{{ block.settings.title | escape }}</p>
                  {%- if block.settings.text != blank -%}<p class="ds-mech__text">{{ block.settings.text | escape }}</p>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ol>
        {%- if section.settings.caution != blank -%}
          <div class="ds-mech__caution" role="note">
            <span class="ds-mech__caution-icon" aria-hidden="true">{%- render 'ds-icon', name: 'alert' -%}</span>
            <div class="ds-rte">{{ section.settings.caution }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.source_label != blank -%}
          <span class="ds-source">
            {{- 'ds.sources.label' | t }}:
            <a href="{{ section.settings.source_url }}" rel="noopener" target="_blank">{{ section.settings.source_label | escape }}<span class="visually-hidden"> ({{ 'accessibility.link_messages.new_window' | t }})</span></a>
          </span>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <p class="ds-mech__more"><a class="ds-link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a></p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "DS · Cómo funciona",
  "tag": "div",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "visible_in",
      "label": "Mostrar en",
      "default": "comercial",
      "options": [
        { "value": "all", "label": "Todos los estados" },
        { "value": "prototipo", "label": "Solo PROTOTIPO" },
        { "value": "comercial", "label": "Solo PREVIEW_COMERCIAL y LIVE" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" },
    { "type": "text", "id": "anchor", "label": "Ancla" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "How this type of mouthpiece works" },
    { "type": "richtext", "id": "intro", "label": "Entradilla" },
    { "type": "product", "id": "product", "label": "Producto", "info": "En la ficha se usa el producto actual." },
    {
      "type": "select",
      "id": "steps_source",
      "label": "Pasos",
      "default": "blocks",
      "options": [
        { "value": "blocks", "label": "Bloques (explicación general)" },
        { "value": "metafield", "label": "Metacampo commercial.how_to_steps (instrucciones del fabricante)" }
      ]
    },
    { "type": "header", "content": "Diagrama" },
    { "type": "checkbox", "id": "show_diagram", "label": "Mostrar diagrama", "default": true },
    { "type": "text", "id": "diagram_title", "label": "Descripción del diagrama (lectores de pantalla)", "default": "Diagram: an upper and a lower tray, with the lower tray held slightly forward" },
    { "type": "text", "id": "legend_1", "label": "Leyenda 1", "default": "Upper tray" },
    { "type": "text", "id": "legend_2", "label": "Leyenda 2", "default": "Lower tray" },
    { "type": "text", "id": "legend_3", "label": "Leyenda 3", "default": "Adjustment point" },
    { "type": "text", "id": "legend_4", "label": "Leyenda 4", "default": "Lower jaw held slightly forward" },
    {
      "type": "checkbox",
      "id": "mechanism_verified",
      "label": "Mecanismo confirmado con la documentación del fabricante",
      "info": "Marcar solo con el IFU del modelo exacto. Desmarcado: aviso ⟦PENDING⟧ junto al diagrama.",
      "default": false
    },
    { "type": "header", "content": "Precauciones y enlaces" },
    { "type": "richtext", "id": "caution", "label": "Precauciones (siempre visibles)" },
    { "type": "text", "id": "source_label", "label": "Fuente (texto)" },
    { "type": "url", "id": "source_url", "label": "Fuente (enlace)" },
    { "type": "text", "id": "link_label", "label": "Enlace (texto)" },
    { "type": "url", "id": "link", "label": "Enlace (destino)" },
    {
      "type": "select",
      "id": "review",
      "label": "Etiqueta de revisión (solo PROTOTIPO)",
      "default": "",
      "options": [
        { "value": "", "label": "Ninguna" },
        { "value": "sanitaria", "label": "Sanitaria" },
        { "value": "fabricante", "label": "Fabricante" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [{ "name": "DS · Cómo funciona" }]
}
{% endschema %}
