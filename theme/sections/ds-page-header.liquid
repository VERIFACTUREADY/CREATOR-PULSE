{%- comment -%}
  Cabecera de página: migas de pan, un único H1, entradilla y fecha de
  revisión. BreadcrumbList JSON-LD con datos reales de la página.
{%- endcomment -%}
{%- liquid
  assign title = section.settings.heading
  if title == blank
    assign title = page.title | default: page_title
  endif
-%}
<section
  class="ds-page-header ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
>
  <div class="page-width">
    <nav class="ds-breadcrumbs" aria-label="{{ 'ds.breadcrumbs.label' | t }}">
      <ol role="list">
        <li><a href="{{ routes.root_url }}">{{ 'ds.breadcrumbs.home' | t }}</a></li>
        <li><span aria-current="page">{{ title | escape }}</span></li>
      </ol>
    </nav>
    {%- render 'ds-review-badge', kind: section.settings.review -%}
    <h1 class="ds-page-header__title">{{ title | escape }}</h1>
    {%- if section.settings.lead != blank -%}
      <div class="ds-lead ds-rte">{{ section.settings.lead }}</div>
    {%- endif -%}
    {%- if section.settings.show_review_date and settings.ds_last_review != blank -%}
      <p class="ds-page-header__meta">{{ 'ds.page.last_review' | t: date: settings.ds_last_review }}</p>
    {%- endif -%}
  </div>
</section>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ 'ds.breadcrumbs.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ title | json }}, "item": {{ canonical_url | json }} }
    ]
  }
</script>

{% schema %}
{
  "name": "DS · Cabecera de página",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" },
    { "type": "text", "id": "heading", "label": "Título (H1)", "info": "Si se deja vacío, se usa el título de la página." },
    { "type": "richtext", "id": "lead", "label": "Entradilla (2–3 líneas)" },
    { "type": "checkbox", "id": "show_review_date", "label": "Mostrar fecha de última revisión", "default": true },
    {
      "type": "select", "id": "review", "label": "Marcador de revisión", "default": "",
      "options": [
        { "value": "", "label": "Ninguno" },
        { "value": "sanitaria", "label": "Pendiente de revisión sanitaria" },
        { "value": "juridica", "label": "Pendiente de revisión jurídica" },
        { "value": "fabricante", "label": "Pendiente de documentación del fabricante" },
        { "value": "titular", "label": "Pendiente de aprobación del titular" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "DS · Cabecera de página" }]
}
{% endschema %}
