{%- comment -%}
  Información documental del producto desde metacampos compliance.*
  (Estudio §12.3). Un dato ausente se muestra como pendiente, nunca como
  aprobado. Las precauciones se abren por defecto: no se esconden.
  Metacampos: manufacturer_legal_name, model_reference, intended_purpose,
  materials, ifu_es, warnings_es, contraindications_es, eu_declaration_ref,
  economic_operator, lot_traceability, delivery_window, claim_approval_version.
{%- endcomment -%}
{%- assign c = product.metafields.compliance -%}
{%- comment -%}
  V2.2: los campos se eligen por MERCADO (ajuste ds_market). En EE. UU. se usan
  regulatory_us.* y nunca los europeos (ifu_es, eu_declaration_ref…), que se conservan
  en compliance.* solo por trazabilidad (docs/V22_MIGRACION_METACAMPOS.md).
{%- endcomment -%}
{%- liquid
  assign u = product.metafields.regulatory_us
  if settings.ds_market == 'eu'
    assign f_purpose = c.intended_purpose
    assign f_ifu = c.ifu_es
    assign f_warn = c.warnings_es
    assign f_contra = c.contraindications_es
  else
    assign f_purpose = u.indications_for_use
    assign f_ifu = u.ifu_en
    assign f_warn = u.warnings_en
    assign f_contra = u.contraindications_en
  endif
-%}
{%- capture ds_mode_d -%}{%- render 'ds-mode' -%}{%- endcapture -%}
{%- capture missing -%}{%- render 'ds-pending', label: 'manufacturer documentation' -%}{%- endcapture -%}
<section
  class="ds-product-details ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  aria-labelledby="DsDetailsTitle-{{ section.id }}"
>
  <div class="page-width">
    <div class="ds-faq__wrap">
      <h2 id="DsDetailsTitle-{{ section.id }}" class="ds-heading h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<div class="ds-rte" style="margin-bottom:2.4rem">{{ section.settings.intro }}</div>{%- endif -%}
      <div class="ds-details__list">
        {%- if ds_mode_d == 'prototipo' -%}
        <details class="ds-details__item">
          <summary>{{ 'ds.product.what' | t }}</summary>
          <div class="ds-details__body">
            <dl class="ds-details__fields">
              <dt>{{ 'ds.product.model' | t }}</dt>
              <dd>{% if c.model_reference != blank %}{{ c.model_reference | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              <dt>{% if settings.ds_market == 'eu' %}{{ 'ds.product.purpose_eu' | t }}{% else %}{{ 'ds.product.purpose' | t }}{% endif %}</dt>
              <dd>{% if f_purpose != blank %}{{ f_purpose | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              <dt>{{ 'ds.product.manufacturer' | t }}</dt>
              <dd>{% if c.manufacturer_legal_name != blank %}{{ c.manufacturer_legal_name | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
            </dl>
          </div>
        </details>
        {%- endif -%}
        {%- if ds_mode_d == 'prototipo' -%}
        <details class="ds-details__item">
          <summary>{{ 'ds.product.how' | t }}</summary>
          <div class="ds-details__body ds-rte">
            {%- if f_ifu != blank -%}{{ f_ifu | metafield_tag }}{%- else -%}<p>{{ 'ds.product.ifu_missing' | t }}</p><p>{{ missing }}</p>{%- endif -%}
          </div>
        </details>
        {%- endif -%}
        <details class="ds-details__item"{% if section.settings.open_safety %} open{% endif %}>
          <summary>{{ 'ds.product.safety' | t }}</summary>
          <div class="ds-details__body ds-rte">
            <dl class="ds-details__fields">
              <dt>{{ 'ds.product.warnings' | t }}</dt>
              <dd>{% if f_warn != blank %}{{ f_warn | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              <dt>{{ 'ds.product.contraindications' | t }}</dt>
              <dd>{% if f_contra != blank %}{{ f_contra | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
            </dl>
            {%- comment -%} Advertencias generales E-09 y E-11 (docs/04_CLAIMS_APPROVAL.csv). {%- endcomment -%}
            {%- render 'ds-review-badge', kind: 'sanitaria' -%}
            <ul>
              <li>{{ 'ds.product.general_1' | t }}</li>
              <li>{{ 'ds.product.general_2' | t }}</li>
            </ul>
            <p><a class="ds-link-arrow" href="/pages/use-and-safety">{{ 'ds.gate.safety' | t }}</a></p>
          </div>
        </details>
        <details class="ds-details__item">
          <summary>{{ 'ds.product.materials' | t }}</summary>
          <div class="ds-details__body ds-rte">
            {%- if c.materials != blank -%}{{ c.materials | metafield_tag }}{%- else -%}<p>{{ missing }}</p>{%- endif -%}
          </div>
        </details>
        <details class="ds-details__item">
          <summary>{{ 'ds.product.docs' | t }}</summary>
          <div class="ds-details__body">
            <dl class="ds-details__fields">
              {%- if settings.ds_market == 'eu' -%}
              <dt>{{ 'ds.product.declaration' | t }}</dt>
              <dd>{% if c.eu_declaration_ref != blank %}{{ c.eu_declaration_ref | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              <dt>{{ 'ds.product.operator' | t }}</dt>
              <dd>{% if c.economic_operator != blank %}{{ c.economic_operator | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              {%- else -%}
              <dt>{{ 'ds.product.us_510k' | t }}</dt>
              <dd>{% if u.fda_510k_number != blank %}{{ u.fda_510k_number | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              <dt>{{ 'ds.product.us_product_code' | t }}</dt>
              <dd>{% if u.fda_product_code != blank %}{{ u.fda_product_code | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              <dt>{{ 'ds.product.us_registration' | t }}</dt>
              <dd>{% if u.fda_registration_listing != blank %}{{ u.fda_registration_listing | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              <dt>{{ 'ds.product.us_importer' | t }}</dt>
              <dd>{% if u.us_importer_of_record != blank %}{{ u.us_importer_of_record | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
              {%- endif -%}
              <dt>{{ 'ds.product.lot' | t }}</dt>
              <dd>{% if c.lot_traceability != blank %}{{ c.lot_traceability | metafield_tag }}{% else %}{{ missing }}{% endif %}</dd>
            </dl>
          </div>
        </details>
        {%- if ds_mode_d == 'prototipo' -%}
        <details class="ds-details__item">
          <summary>{{ 'ds.product.shipping' | t }}</summary>
          <div class="ds-details__body ds-rte">
            <p><strong>{{ 'ds.product.delivery' | t }}:</strong>
              {% if product.metafields.commercial.delivery_window != blank %}{{ product.metafields.commercial.delivery_window | metafield_tag }}{% else %}{% render 'ds-pending', label: 'confirmed delivery time' %}{% endif %}</p>
            <p><a href="/pages/shipping">{{ 'ds.product.shipping_link' | t }}</a> · <a href="/pages/returns">{{ 'ds.product.returns_link' | t }}</a></p>
          </div>
        </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DS · Datos del producto",
  "tag": "div",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Technical details and precautions"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introducción"
    },
    {
      "type": "checkbox",
      "id": "open_safety",
      "label": "Precauciones abiertas por defecto",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "DS · Datos del producto"
    }
  ]
}
{% endschema %}
