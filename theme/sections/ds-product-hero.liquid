{%- comment -%}
  Hero comercial (auditoría V2, C-01 / C-05): producto real, una propuesta clara,
  precio si está confirmado y una sola CTA primaria hacia la ficha. Pensado para
  la primera pantalla móvil. Nada se inventa: lo que falta sale como ⟦PENDIENTE⟧.
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
  assign heading = section.settings.heading
  if heading == blank and p != blank
    assign heading = p.title
  endif
-%}
<section
  class="ds-phero ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  aria-labelledby="DsPHeroTitle-{{ section.id }}"
>
  <div class="page-width ds-phero__grid">
    <div class="ds-phero__media">
      {%- if p.featured_media != blank -%}
        {{
          p.featured_media
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 550, 750, 1000, 1200',
            sizes: '(min-width: 990px) 45vw, 100vw',
            alt: p.featured_media.alt
        }}
      {%- else -%}
        {%- render 'ds-photo-placeholder', label: 'Foto principal: producto real sobre fondo neutro' -%}
      {%- endif -%}
    </div>
    <div class="ds-phero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="DsPHeroTitle-{{ section.id }}" class="ds-phero__title">
        {%- if heading != blank -%}{{ heading | escape }}{%- else -%}{%- render 'ds-pending', label: 'producto' -%}{%- endif -%}
      </h1>
      {%- if section.settings.subheading != blank -%}<div class="ds-phero__text ds-rte">{{ section.settings.subheading }}</div>{%- endif -%}
      {%- if section.settings.show_benefit -%}
        <p class="ds-phero__benefit">
          {%- if p.metafields.commercial.short_benefit != blank -%}
            {{ p.metafields.commercial.short_benefit | metafield_tag }}
          {%- else -%}
            {%- render 'ds-pending', label: 'beneficio aprobado en la ficha comercial' -%}
          {%- endif -%}
        </p>
      {%- endif -%}
      {%- if p != blank -%}
        <div class="ds-phero__price">{%- render 'price', product: p, use_variant: true -%}</div>
      {%- endif -%}
      <div class="ds-phero__actions">
        <a class="button button--primary" href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}">
          {{- section.settings.button_label | default: 'Ver el producto' | escape -}}
        </a>
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="ds-link-arrow" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.show_points -%}
        {%- render 'ds-offer-points', product: p, compact: true -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "DS · Hero de producto",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "select", "id": "visible_in", "label": "Mostrar en", "default": "comercial", "options": [{ "value": "all", "label": "Todos los estados" }, { "value": "prototipo", "label": "Solo PROTOTIPO" }, { "value": "comercial", "label": "Solo PREVIEW_COMERCIAL y LIVE" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "product", "id": "product", "label": "Producto", "info": "En la ficha se usa el producto actual." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Descansar juntos importa" },
    { "type": "text", "id": "heading", "label": "Titular (H1)", "info": "Vacío = nombre del producto. Usar solo mensajes aprobados." },
    { "type": "richtext", "id": "subheading", "label": "Subtítulo (1–2 frases)" },
    { "type": "checkbox", "id": "show_benefit", "label": "Mostrar el beneficio aprobado (metacampo commercial.short_benefit)", "default": true },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Ver el producto" },
    { "type": "text", "id": "secondary_label", "label": "Enlace secundario", "default": "Cómo funciona" },
    { "type": "url", "id": "secondary_link", "label": "Enlace secundario (destino)" },
    { "type": "checkbox", "id": "show_points", "label": "Mostrar envío, devoluciones, atención y pago", "default": true },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "DS · Hero de producto" }]
}
{% endschema %}
