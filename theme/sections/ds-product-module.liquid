{%- comment -%}
  Módulo de ficha comercial leído de los metacampos commercial.* del producto
  (auditoría V2, C-02): qué es, cómo se usa (pasos), para quién, qué incluye,
  características o cuidados. El texto lo aporta la ficha aprobada del titular;
  si falta, se muestra ⟦PENDIENTE⟧ y LIVE queda bloqueado para ese producto.
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
  assign key = section.settings.module
  assign m = p.metafields.commercial[key]
  case key
    when 'what_is'
      assign label = 'qué es (ficha comercial)'
    when 'how_to_steps'
      assign label = 'pasos de uso (ficha comercial)'
    when 'for_whom'
      assign label = 'para quién (ficha comercial)'
    when 'includes'
      assign label = 'qué incluye (ficha comercial)'
    when 'features'
      assign label = 'características (ficha comercial)'
    else
      assign label = 'cuidados y limpieza (ficha comercial)'
  endcase
-%}
<section
  class="ds-pmodule ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  aria-labelledby="DsPMod-{{ section.id }}"
>
  <div class="page-width">
    <div class="ds-section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="DsPMod-{{ section.id }}" class="ds-heading h2">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if key == 'how_to_steps' -%}
      <ol class="ds-steps__list ds-pmodule__steps" role="list">
        {%- if m != blank -%}
          {%- if m.type contains 'list.' -%}
            {%- assign steps = m.value -%}
          {%- else -%}
            {%- assign steps = m.value | newline_to_br | split: '<br />' -%}
          {%- endif -%}
          {%- for step in steps -%}
            {%- assign st = step | strip -%}
            {%- if st != blank -%}
              <li class="ds-steps__item"><div class="ds-steps__link"><span class="ds-steps__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><span class="ds-steps__title">{{ st | escape }}</span></div></li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <li class="ds-steps__item"><div class="ds-steps__link"><span class="ds-steps__num" aria-hidden="true">0{{ i }}</span><span>{%- render 'ds-pending', label: label -%}</span></div></li>
          {%- endfor -%}
        {%- endif -%}
      </ol>
    {%- else -%}
      <div class="ds-pmodule__body ds-rte">
        {%- if m != blank -%}{{ m | metafield_tag }}{%- else -%}<p>{%- render 'ds-pending', label: label -%}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <p class="ds-pmodule__link"><a class="ds-link-arrow" href="{% if section.settings.link != blank %}{{ section.settings.link }}{% elsif p != blank %}{{ p.url }}{% else %}#{% endif %}">{{ section.settings.link_label | escape }}</a></p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "DS · Módulo de ficha",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "select", "id": "visible_in", "label": "Mostrar en", "default": "comercial", "options": [{ "value": "all", "label": "Todos los estados" }, { "value": "prototipo", "label": "Solo PROTOTIPO" }, { "value": "comercial", "label": "Solo PREVIEW_COMERCIAL y LIVE" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "product", "id": "product", "label": "Producto", "info": "En la ficha se usa el producto actual." },
    {
      "type": "select", "id": "module", "label": "Contenido (metacampo commercial.*)", "default": "what_is",
      "options": [
        { "value": "what_is", "label": "Qué es (commercial.what_is)" },
        { "value": "how_to_steps", "label": "Cómo se usa, por pasos (commercial.how_to_steps)" },
        { "value": "for_whom", "label": "Para quién (commercial.for_whom)" },
        { "value": "includes", "label": "Qué incluye (commercial.includes)" },
        { "value": "features", "label": "Características (commercial.features)" },
        { "value": "care", "label": "Cuidados y limpieza (commercial.care)" }
      ]
    },
    { "type": "text", "id": "anchor", "label": "Ancla" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Qué es" },
    { "type": "text", "id": "link_label", "label": "Enlace (texto)" },
    { "type": "url", "id": "link", "label": "Enlace (vacío = ficha del producto)" },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "DS · Módulo de ficha" }]
}
{% endschema %}
