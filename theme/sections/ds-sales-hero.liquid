{%- comment -%}
  V4 · Hero de página de venta (estructura tipo HONEX, contenido propio):
  titular grande centrado, subtítulo, foto de producto con sello de garantía y
  fila de 3 puntos de confianza. Los datos (garantía, envío, devoluciones) salen
  de Ajustes del tema › Oferta: si faltan, el sello no aparece y el punto muestra
  un pendiente discreto (y en LIVE bloquea, como siempre).
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
<section
  class="ds-shero ds-section color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'ds-section-vars', section: section %}"
  aria-labelledby="DsSHero-{{ section.id }}"
>
  <div class="page-width ds-shero__grid">
    <div class="ds-shero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="ds-pill">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="DsSHero-{{ section.id }}" class="ds-shero__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<div class="ds-shero__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.show_price -%}
        {%- assign p = section.settings.product -%}
        <div class="ds-shero__price">
          {%- if p != blank -%}{%- render 'price', product: p, use_variant: true -%}{%- else -%}{%- render 'ds-pending', label: 'price' -%}{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button button--primary ds-btn-xl ds-shero__cta" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="ds-shero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '375, 550, 750, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt }}
      {%- else -%}
        {%- render 'ds-photo-placeholder', label: 'Main product photo' -%}
      {%- endif -%}
      {%- if section.settings.show_badge and settings.ds_offer_guarantee != blank -%}
        <p class="ds-seal" aria-hidden="true"><span>{{ settings.ds_offer_guarantee | escape }}</span></p>
      {%- endif -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <ul class="page-width ds-trustrow" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign v = block.settings.text
          assign pending = ''
          case block.settings.kind
            when 'guarantee'
              assign v = settings.ds_offer_guarantee
              assign pending = 'guarantee'
            when 'shipping'
              assign v = settings.ds_offer_shipping
              assign pending = 'shipping'
            when 'returns'
              assign v = settings.ds_offer_returns
              assign pending = 'returns'
            when 'support'
              assign v = settings.ds_offer_support
              assign pending = 'customer care'
          endcase
        -%}
        <li class="ds-trustrow__item" {{ block.shopify_attributes }}>
          <span class="ds-trustrow__icon" aria-hidden="true">{%- render 'ds-icon', name: block.settings.icon -%}</span>
          <strong class="ds-trustrow__title">{{ block.settings.title | escape }}</strong>
          <span class="ds-trustrow__text">
            {%- if v != blank -%}{{ v | escape }}{%- else -%}{%- render 'ds-pending', label: pending -%}{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "DS · Hero de venta",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "select", "id": "visible_in", "label": "Mostrar en", "default": "comercial", "options": [
      { "value": "all", "label": "Todos los estados" },
      { "value": "prototipo", "label": "Solo PROTOTIPO" },
      { "value": "comercial", "label": "Solo PREVIEW_COMERCIAL y LIVE" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior" },
    { "type": "text", "id": "heading", "label": "Titular (H1)", "default": "Peaceful nights, for both of you." },
    { "type": "richtext", "id": "text", "label": "Subtítulo" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "url", "id": "button_link", "label": "Botón (destino)" },
    { "type": "image_picker", "id": "image", "label": "Foto principal" },
    { "type": "product", "id": "product", "label": "Producto (precio)" },
    { "type": "checkbox", "id": "show_price", "label": "Mostrar precio (solo si está confirmado)", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "Sello redondo con la garantía (Ajustes › Oferta)", "default": true },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "trust", "name": "Punto de confianza", "settings": [
      { "type": "select", "id": "kind", "label": "Dato", "default": "shipping", "options": [
        { "value": "guarantee", "label": "Garantía (Ajustes › Oferta)" },
        { "value": "shipping", "label": "Envío (Ajustes › Oferta)" },
        { "value": "returns", "label": "Devoluciones (Ajustes › Oferta)" },
        { "value": "support", "label": "Atención (Ajustes › Oferta)" },
        { "value": "custom", "label": "Texto propio (verificable)" } ] },
      { "type": "select", "id": "icon", "label": "Icono", "default": "truck", "options": [
        { "value": "shield", "label": "Escudo" }, { "value": "truck", "label": "Envío" },
        { "value": "return", "label": "Devolución" }, { "value": "chat", "label": "Atención" },
        { "value": "card", "label": "Pago" }, { "value": "box", "label": "Caja" } ] },
      { "type": "text", "id": "title", "label": "Título" },
      { "type": "text", "id": "text", "label": "Texto propio" } ] }
  ],
  "presets": [{ "name": "DS · Hero de venta" }]
}
{% endschema %}
