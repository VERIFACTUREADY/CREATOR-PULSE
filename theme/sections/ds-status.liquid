{%- comment -%}
  Estado documental del producto (Estudio §12.2 punto 5: «Producto en
  evaluación documental»). Muestra con honestidad qué falta. Se oculta sola
  cuando el comercio está habilitado, salvo que se indique lo contrario.
{%- endcomment -%}
{%- capture ds_show -%}{%- render 'ds-visible', when: section.settings.visible_in -%}{%- endcapture -%}
{%- if ds_show == 'true' -%}
  <section
    class="ds-status ds-section color-{{ section.settings.color_scheme }} gradient"
    style="{% render 'ds-section-vars', section: section %}"
    aria-labelledby="DsStatusTitle-{{ section.id }}"
  >
    <div class="page-width">
      <div class="ds-section-head">
        {%- if section.settings.eyebrow != blank -%}<p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="DsStatusTitle-{{ section.id }}" class="ds-heading h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}<div class="ds-rte">{{ section.settings.intro }}</div>{%- endif -%}
      </div>
      <ul class="ds-status__list" role="list">
        {%- for block in section.blocks -%}
          <li class="ds-status__item" {{ block.shopify_attributes }}>
            <span class="ds-status__label">
              {{- block.settings.label | escape -}}
              {%- if block.settings.note != blank -%}<span class="ds-status__note">{{ block.settings.note | escape }}</span>{%- endif -%}
            </span>
            <span class="ds-pill ds-pill--{{ block.settings.status }}">
              {%- case block.settings.status -%}
                {%- when 'verified' -%}{{ 'ds.status.verified' | t }}
                {%- when 'in_review' -%}{{ 'ds.status.in_review' | t }}
                {%- when 'blocked' -%}{{ 'ds.status.blocked' | t }}
                {%- else -%}{{ 'ds.status.pending' | t }}
              {%- endcase -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "DS · Estado del producto",
  "tag": "div",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "visible_in",
      "label": "Mostrar en",
      "default": "prototipo",
      "options": [
        {
          "value": "all",
          "label": "Todos los estados"
        },
        {
          "value": "prototipo",
          "label": "Solo PROTOTIPO"
        },
        {
          "value": "comercial",
          "label": "Solo PREVIEW_COMERCIAL y LIVE"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Product under document review"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Before we sell, we check"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introducción"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Requisito",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Requisito",
          "default": "Manufacturer documentation"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Nota breve"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Estado",
          "default": "pending",
          "info": "Marcar «Comprobado» solo con evidencia registrada en docs/12_REGISTRO_EVIDENCIAS.md.",
          "options": [
            {
              "value": "pending",
              "label": "Pendiente"
            },
            {
              "value": "in_review",
              "label": "En revisión"
            },
            {
              "value": "verified",
              "label": "Comprobado"
            },
            {
              "value": "blocked",
              "label": "Bloqueado"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS · Estado del producto",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
