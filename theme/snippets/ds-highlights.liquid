{% comment %}
  V3 · Características resumidas junto a la compra (commercial.features). Si falta, ⟦PENDING⟧.
  Accepts: product, block
{% endcomment %}
{%- capture ds_hv -%}{%- render 'ds-visible', when: 'comercial' -%}{%- endcapture -%}
{%- if ds_hv == 'true' -%}
  <div class="ds-highlights" {{ block.shopify_attributes }}>
    {%- if product.metafields.commercial.features != blank -%}
      <div class="ds-highlights__body ds-rte">{{ product.metafields.commercial.features | metafield_tag }}</div>
    {%- else -%}
      <p class="ds-highlights__body">{%- render 'ds-pending', label: 'key features (approved product sheet)' -%}</p>
    {%- endif -%}
    <a class="ds-link-arrow ds-highlights__link" href="#features">{{ 'ds.v3.all_features' | t }}</a>
  </div>
{%- endif -%}
