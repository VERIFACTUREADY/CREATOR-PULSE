{% comment %}
  Iconos de línea originales del prototipo (sin licencias de terceros).
  Accepts:
  - name: {String} moon | pillows | info | alert | question | doc | truck | return | mail | book | check | clock | chat | compare | person | steps | pause
{% endcomment %}
<svg class="ds-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'moon' -%}<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/>
    {%- when 'pillows' -%}<rect x="2.5" y="8" width="8.5" height="6" rx="3"/><rect x="13" y="8" width="8.5" height="6" rx="3"/><path d="M2 18h20"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5v.5"/>
    {%- when 'alert' -%}<path d="M12 3.5 2.8 19.5h18.4L12 3.5Z"/><path d="M12 10v4M12 16.8v.4"/>
    {%- when 'question' -%}<circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .8-1 1.5v.4M12 16.6v.4"/>
    {%- when 'doc' -%}<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'return' -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
    {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'book' -%}<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/>
    {%- when 'check' -%}<circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.7 2.7L16.5 9.5"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'chat' -%}<path d="M20 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10Z"/>
    {%- when 'compare' -%}<path d="M8 3v18M16 3v18M3 8h5M16 16h5"/>
    {%- when 'person' -%}<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>
    {%- when 'steps' -%}<path d="M4 18h5v-4h5v-4h6"/>
    {%- when 'pause' -%}<circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
