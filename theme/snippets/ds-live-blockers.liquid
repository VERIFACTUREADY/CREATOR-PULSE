{%- comment -%}
  Lista (separada por « · ») de datos GLOBALES que impiden LIVE. Vacía si no falta nada.
  Los datos de cada producto se comprueban aparte en ds-product-missing.
{%- endcomment -%}
{%- liquid
  assign out = ''
  unless settings.ds_brand_confirmed
    assign out = out | append: 'brand confirmation (trademark and domain search) · '
  endunless
  if settings.ds_seller_country == blank
    assign out = out | append: 'seller country · '
  endif
  if settings.ds_legal_name == blank
    assign out = out | append: 'legal business name · '
  endif
  if settings.ds_legal_tax_id == blank
    assign out = out | append: 'tax ID · '
  endif
  if settings.ds_legal_address == blank
    assign out = out | append: 'business address · '
  endif
  if settings.ds_legal_email == blank
    assign out = out | append: 'contact email · '
  endif
  if settings.ds_offer_shipping == blank
    assign out = out | append: 'shipping · '
  endif
  if settings.ds_offer_returns == blank
    assign out = out | append: 'returns · '
  endif
  if settings.ds_offer_support == blank
    assign out = out | append: 'customer care · '
  endif
  if settings.ds_offer_payment == blank
    assign out = out | append: 'payment methods · '
  endif
  echo out | remove_last: ' · '
-%}
