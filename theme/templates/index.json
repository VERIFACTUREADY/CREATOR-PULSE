          "settings": {
            "icon": "moon",
            "title": "Qué son los ronquidos",
            "text": "<p>Es el sonido que se produce al respirar mientras duermes, cuando el paso del aire se estrecha.</p>",
            "source_label": "Guía clínica AASM/AADSM, 2015",
            "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4481062/",
