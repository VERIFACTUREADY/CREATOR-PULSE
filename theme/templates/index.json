          }
        },
        "basics_2": {
          "type": "card",
          "settings": {
            "icon": "compare",
            "title": "No todas las causas son iguales",
            "text": "<p>No todos los ronquidos tienen el mismo origen. Por eso no existe una solución que sirva a todo el mundo.</p>",
            "source_label": "American Dental Association: apnea obstructiva del sueño",
            "source_url": "https://www.ada.org/resources/ada-library/oral-health-topics/sleep-apnea-obstructive",
            "link_label": "Ver las opciones",
            "link": "/pages/como-funciona#opciones"
          }
        },
        "basics_3": {
          "type": "card",
          "settings": {
            "icon": "alert",
            "title": "Cuándo conviene consultar",
            "text": "<p>Si alguien ve que dejas de respirar unos segundos mientras duermes, si te despiertas con sensación de ahogo o si tienes mucho sueño durante el día, consulta con un profesional sanitario.</p>",
            "source_label": "American Dental Association: apnea obstructiva del sueño",
            "source_url": "https://www.ada.org/resources/ada-library/oral-health-topics/sleep-apnea-obstructive",
