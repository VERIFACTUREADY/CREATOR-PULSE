        "content_9"
      ]
    },
    "compare": {
      "type": "ds-compare",
      "settings": {
        "anchor": "tabla-opciones",
        "heading": "Opciones frente a los ronquidos",
        "intro": "<p>Las tiras nasales, los dilatadores nasales y las férulas bucales no actúan de la misma forma.</p>",
        "caption": "Comparación de mecanismos. No indica eficacia. Si tienes dudas sobre tu caso, consulta con un profesional.",
        "review": "sanitaria",
        "padding_top": 16
      },
      "blocks": {
        "compare_1": {
          "type": "row",
          "settings": {
            "name": "Férula bucal ajustable",
            "what": "Aparato reutilizable que se pone en la boca para dormir.",
            "where": "En la posición de la mandíbula.",
            "consider": "Ajuste, comodidad, posibles molestias y documentación del producto."
          }
        },
        "compare_2": {
          "type": "row",
          "settings": {
            "name": "Férula hecha a medida",
            "what": "Aparato que fabrica y ajusta un profesional de la odontología.",
            "where": "En la posición de la mandíbula.",
            "consider": "Necesita consulta y seguimiento. Precio más alto."
          }
        },
        "compare_3": {
          "type": "row",
          "settings": {
            "name": "Tiras nasales",
            "what": "Adhesivo de un solo uso que se pega en la nariz.",
            "where": "En la nariz.",
            "consider": "Su utilidad depende de la causa del ronquido."
          }
        },
        "compare_4": {
          "type": "row",
          "settings": {
            "name": "Dilatador nasal",
            "what": "Pieza reutilizable que se coloca en la nariz.",
            "where": "En la nariz.",
            "consider": "Funciona de otra forma. Cada persona lo tolera de manera distinta."
          }
        },
        "compare_5": {
          "type": "row",
          "settings": {
            "name": "Sprays y otros remedios",
            "what": "Productos variados, normalmente de un solo uso.",
            "where": "Depende del producto.",
            "consider": "La eficacia y las autorizaciones cambian en cada producto."
          }
        },
        "compare_6": {
          "type": "row",
          "settings": {
            "name": "Cambios de hábitos y valoración médica",
            "what": "No es un producto.",
            "where": "Depende de la causa.",
            "consider": "Puede ser lo más adecuado según la causa del ronquido."
          }
        }
      },
      "block_order": [
        "compare_1",
        "compare_2",
