    },
    "glossary": {
      "type": "ds-glossary",
      "settings": {
        "heading": "Glosario: palabras que conviene entender",
        "review": "sanitaria"
      },
      "blocks": {
        "glossary_1": {
          "type": "term",
          "settings": {
            "term": "Férula bucal",
            "definition": "Aparato que se coloca en la boca. Hay férulas con fines distintos."
          }
        },
        "glossary_2": {
          "type": "term",
          "settings": {
            "term": "Avance mandibular",
            "definition": "Mantener la mandíbula inferior un poco hacia delante mientras duermes."
          }
        },
        "glossary_3": {
          "type": "term",
          "settings": {
            "term": "Apnea del sueño",
            "definition": "Trastorno en el que la respiración se interrumpe varias veces durante el sueño. Lo diagnostica un profesional sanitario."
          }
        },
        "glossary_4": {
          "type": "term",
          "settings": {
            "term": "Indicación",
            "definition": "Situación en la que un producto o tratamiento está recomendado."
          }
        },
        "glossary_5": {
          "type": "term",
          "settings": {
            "term": "Contraindicación",
            "definition": "Situación en la que no se debe usar un producto o tratamiento."
          }
        },
        "glossary_6": {
          "type": "term",
          "settings": {
            "term": "Finalidad prevista",
            "definition": "Para qué ha diseñado el fabricante un producto sanitario. Solo se puede anunciar lo que encaja con esa finalidad."
          }
        },
        "glossary_7": {
          "type": "term",
          "settings": {
            "term": "Marcado CE",
            "definition": "Símbolo que indica que el fabricante declara que el producto cumple las normas europeas que le aplican."
          }
        },
        "glossary_8": {
          "type": "term",
          "settings": {
            "term": "Declaración UE de conformidad",
            "definition": "Documento firmado por el fabricante que acredita esa conformidad para un modelo concreto."
          }
        },
        "glossary_9": {
          "type": "term",
          "settings": {
            "term": "Instrucciones de uso",
            "definition": "Documento del fabricante que explica cómo usar, ajustar y limpiar el producto, y sus advertencias."
          }
        }
      },
