      },
      "blocks": {
        "glossary_1": {
          "type": "term",
          "settings": {
            "term": "Oral appliance",
            "definition": "A device worn in the mouth. Oral appliances can have different purposes."
          }
        },
        "glossary_2": {
          "type": "term",
          "settings": {
            "term": "Mandibular advancement",
            "definition": "Holding the lower jaw slightly forward while you sleep."
          }
        },
        "glossary_3": {
          "type": "term",
          "settings": {
            "term": "Sleep apnea",
            "definition": "A disorder in which breathing stops and starts repeatedly during sleep. It is diagnosed by a healthcare provider."
          }
        },
        "glossary_4": {
          "type": "term",
          "settings": {
            "term": "Indication",
            "definition": "A situation in which a product or treatment is recommended."
          }
        },
        "glossary_5": {
          "type": "term",
          "settings": {
            "term": "Contraindication",
            "definition": "A situation in which a product or treatment should not be used."
          }
        },
        "glossary_6": {
          "type": "term",
          "settings": {
            "term": "Intended use",
            "definition": "What the manufacturer designed a medical device for. A product can only be marketed for its intended use."
          }
        },
        "glossary_7": {
          "type": "term",
          "settings": {
            "term": "FDA 510(k) clearance",
            "definition": "An FDA review pathway for many medical devices. A cleared device has a 510(k) number you can look up. “Cleared” is not the same as “approved.”"
          }
        },
        "glossary_8": {
          "type": "term",
          "settings": {
            "term": "Instructions for use",
            "definition": "The manufacturer's document explaining how to use, fit and clean the product, and its warnings."
          }
        }
      },
