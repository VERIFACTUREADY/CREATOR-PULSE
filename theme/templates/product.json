/*
 * Ficha de producto del prototipo: sin precio, sin cantidad, sin compra rápida ni
 * reseñas. La compuerta ds-commerce-ready decide si se muestra la compra.
 */
{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "status": {
          "type": "text",
          "settings": {
            "text": "Producto en evaluación documental",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        }
      },
      "block_order": [
        "status",
        "title",
        "price",
        "variant_picker",
        "buy_buttons",
        "description"
      ],
      "settings": {
        "enable_sticky_info": false,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "none",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 40,
        "padding_bottom": 24
      }
    },
    "details": {
      "type": "ds-product-details",
      "settings": {
        "heading": "Información del producto",
        "open_safety": true
      }
    }
  },
  "order": [
    "main",
    "details"
  ]
}
