/*
 * Product page V2.1: offer visible in PREVIEW_COMERCIAL; purchase only in LIVE with complete data (ds-commerce-ready).
 */
{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 40,
        "padding_bottom": 24
      },
      "blocks": {
        "main_1": {
          "type": "ds_prototype_label",
          "settings": {
            "text": "Product under document review"
          }
        },
        "main_2": {
          "type": "title",
          "settings": {}
        },
        "main_3": {
          "type": "ds_benefit",
          "settings": {}
        },
        "main_4": {
          "type": "price",
          "settings": {}
        },
        "main_5": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "main_6": {
          "type": "quantity_selector",
          "settings": {}
        },
        "main_7": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "main_8": {
          "type": "ds_offer_points",
          "settings": {}
        },
        "main_9": {
          "type": "description",
          "settings": {}
        }
      },
      "block_order": [
        "main_1",
        "main_2",
        "main_3",
        "main_4",
        "main_5",
        "main_6",
        "main_7",
        "main_8",
        "main_9"
      ]
    },
    "what": {
      "type": "ds-product-module",
      "settings": {
        "visible_in": "comercial",
        "module": "what_is",
        "heading": "What it is",
        "anchor": "what-it-is"
      }
    },
    "how": {
      "type": "ds-product-module",
      "settings": {
        "visible_in": "comercial",
        "module": "how_to_steps",
        "heading": "How to use it, step by step",
        "anchor": "how-to-use",
        "color_scheme": "scheme-2"
      }
    },
    "forwhom": {
      "type": "ds-product-module",
      "settings": {
        "visible_in": "comercial",
        "module": "for_whom",
        "heading": "Who it's for",
        "anchor": "who-its-for"
      }
    },
    "includes": {
      "type": "ds-product-module",
      "settings": {
        "visible_in": "comercial",
        "module": "includes",
        "heading": "What's included",
        "anchor": "whats-included",
        "color_scheme": "scheme-5"
      }
    },
    "care": {
      "type": "ds-product-module",
      "settings": {
        "visible_in": "comercial",
        "module": "care",
        "heading": "Care and cleaning",
        "anchor": "care"
      }
    },
    "details": {
      "type": "ds-product-details",
      "settings": {
        "heading": "Technical details and precautions",
        "open_safety": true
      }
    },
    "faq": {
      "type": "ds-faq",
      "settings": {
        "visible_in": "comercial",
        "heading": "Frequently asked questions"
      },
      "blocks": {
        "faq_1": {
          "type": "question",
          "settings": {
            "question": "How much is shipping and how long does it take?",
            "answer": "<p>[[ENVIO]]</p>",
            "link_label": "Shipping policy",
            "link": "/pages/shipping",
            "visible_in": "comercial"
          }
        },
        "faq_2": {
          "type": "question",
          "settings": {
            "question": "Can I return it?",
            "answer": "<p>[[DEVOLUCIONES]]</p>",
            "link_label": "Return policy",
            "link": "/pages/returns",
            "visible_in": "comercial"
          }
        },
        "faq_3": {
          "type": "question",
          "settings": {
            "question": "Is it right for me?",
            "answer": "<p>The product page explains who it is intended for and its precautions. If you have questions about your health, talk to a healthcare provider or your dentist.</p>",
            "link_label": "Use & safety",
            "link": "/pages/use-and-safety",
            "visible_in": "comercial"
          }
        },
        "faq_4": {
          "type": "question",
          "settings": {
            "question": "Is snoring the same as sleep apnea?",
            "answer": "<p>No. Snoring and sleep apnea are not the same thing. Some signs need to be checked by a healthcare provider.</p>",
            "link_label": "See the signs",
            "link": "/pages/use-and-safety#when-to-talk-to-a-provider",
            "visible_in": "all"
          }
        },
        "faq_5": {
          "type": "question",
          "settings": {
            "question": "Which payment methods do you accept?",
            "answer": "<p>[[PAGO]]</p>",
            "link_label": "",
            "link": "",
            "visible_in": "comercial"
          }
        },
        "faq_6": {
          "type": "question",
          "settings": {
            "question": "How can I contact you?",
            "answer": "<p>[[ATENCION]]</p>",
            "link_label": "Contact us",
            "link": "/pages/contact",
            "visible_in": "comercial"
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4",
        "faq_5",
        "faq_6"
      ]
    },
    "help": {
      "type": "ds-callout",
      "settings": {
        "visible_in": "all",
        "color_scheme": "scheme-2",
        "style": "center",
        "heading": "Have another question?",
        "text": "<p>Write to us and we'll get back to you. Please don't include health information.</p>",
        "button_label": "Contact us",
        "button_link": "/pages/contact",
        "button_secondary": true,
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "main",
    "what",
    "how",
    "forwhom",
    "includes",
    "care",
    "details",
    "faq",
    "help"
  ]
}
